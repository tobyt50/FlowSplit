# Ignore git files
.git
.gitignore

# Ignore node_modules (we install them fresh in the container)
node_modules
**/node_modules

# Ignore build artifacts
dist
**/dist
.next
**/.next
__pycache__
**/*.pyc

# Ignore local env files (Render injects env vars differently)
.env
.env.*

# Ignore logs
npm-debug.log
yarn-error.log
pnpm-debug.log

# CRITICAL: Ensure we DO NOT ignore our source code
!packages/
!infra/
!pnpm-lock.yaml
!package.json
!turbo.json